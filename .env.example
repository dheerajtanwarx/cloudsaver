# Copy to .env and adjust. Credentials come from the default AWS credential chain
# (aws configure / AWS_PROFILE) - never put access keys in this file.
AWS_REGION=ap-south-1
# AWS_PROFILE=cloudsaver
SCAN_ALL_REGIONS=false
DEMO_MODE=false
USD_TO_INR=84
IDLE_CPU_THRESHOLD=10
SNAPSHOT_AGE_DAYS=30
PORT=4000
